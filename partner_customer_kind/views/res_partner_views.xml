<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.customer.kind</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc']" position="inside">
                <field name="customer_kind" />
            </xpath>
        </field>
    </record>
    <record id="res_partner_view_list" model="ir.ui.view">
        <field name="name">res.partner.list.customer.kind</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="customer_kind" optional="hide" />
            </field>
        </field>
    </record>
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.select.customer.kind</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="customer_kind" />
            </field>
            <filter name="type_company" position="after">
                <separator />
                <filter
                    name="customer_kind_hospital"
                    string="Hospital"
                    domain="[('customer_kind', '=', 'hospital')]"
                />
                <filter
                    name="customer_kind_dealer"
                    string="Dealer"
                    domain="[('customer_kind', '=', 'dealer')]"
                />
                <filter
                    name="customer_kind_individual"
                    string="Individual"
                    domain="[('customer_kind', '=', 'individual')]"
                />
                <filter
                    name="customer_kind_veterinary_hospital"
                    string="Veterinary Hospital"
                    domain="[('customer_kind', '=', 'veterinary_hospital')]"
                />
            </filter>
            <filter name="salesperson" position="after">
                <filter
                    name="group_customer_kind"
                    string="Customer Kind"
                    context="{'group_by': 'customer_kind'}"
                />
            </filter>
        </field>
    </record>
</odoo>
