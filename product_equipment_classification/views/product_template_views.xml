<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.equipment.classification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="product_tag_ids" position="after">
                <field
                    name="equipment_classification_id"
                    options="{'no_quick_create': True}"
                />
                <field
                    name="equipment_classification_sub_id"
                    options="{'no_quick_create': True}"
                />
            </field>
        </field>
    </record>

    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.search.equipment.classification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <field name="product_tag_ids" position="after">
                <field name="equipment_classification_id" />
                <field name="equipment_classification_sub_id" />
            </field>
        </field>
    </record>
</odoo>
