<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_equipment_classification_view_list" model="ir.ui.view">
        <field name="name">product.equipment.classification.list</field>
        <field name="model">product.equipment.classification</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="description" optional="hide" />
            </list>
        </field>
    </record>

    <record id="product_equipment_classification_view_form" model="ir.ui.view">
        <field name="name">product.equipment.classification.form</field>
        <field name="model">product.equipment.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_equipment_classification_view_search" model="ir.ui.view">
        <field name="name">product.equipment.classification.search</field>
        <field name="model">product.equipment.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="product_equipment_classification_action" model="ir.actions.act_window">
        <field name="name">Equipment Classifications</field>
        <field name="res_model">product.equipment.classification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an equipment classification
            </p>
            <p>
                Equipment classifications can be assigned to products to
                categorize medical devices.
            </p>
        </field>
    </record>

    <menuitem
        id="product_equipment_classification_menu"
        action="product_equipment_classification_action"
        parent="stock.menu_stock_config_settings"
        sequence="100"
        groups="stock.group_stock_manager"
    />
</odoo>
