<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="obc_export_id" invisible="not obc_export_id" />
            </xpath>
        </field>
    </record>
    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">account.move.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="obc_export_id" optional="show" />
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='date']" position="after">
                <separator />
                <filter
                    name="obc_exported"
                    string="Exported to OBC"
                    domain="[('obc_export_id', '!=', False)]"
                />
                <filter
                    name="obc_not_exported"
                    string="Not Exported to OBC"
                    domain="[('obc_export_id', '=', False)]"
                />
                <separator />
            </xpath>
        </field>
    </record>
</odoo>
