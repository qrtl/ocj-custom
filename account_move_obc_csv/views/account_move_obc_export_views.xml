<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_obc_export_view_form" model="ir.ui.view">
        <field name="name">account.move.obc.export.form</field>
        <field name="model">account.move.obc.export</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_export"
                        type="object"
                        string="Export CSV"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_moves"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            invisible="not move_count"
                        >
                            <field
                                name="move_count"
                                widget="statinfo"
                                string="Journal Entries"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="date_from"
                                string="Period"
                                widget="daterange"
                                options="{'end_date_field': 'date_to'}"
                                readonly="move_count"
                            />
                            <field name="date_to" invisible="1" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                readonly="move_count"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="account_move_obc_export_view_list" model="ir.ui.view">
        <field name="name">account.move.obc.export.list</field>
        <field name="model">account.move.obc.export</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="move_count" string="Journal Entries" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="account_move_obc_export_action" model="ir.actions.act_window">
        <field name="name">OBC Exports</field>
        <field name="res_model">account.move.obc.export</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="account_move_obc_export_menu"
        action="account_move_obc_export_action"
        parent="account.account_closing_menu"
        groups="account.group_account_user"
        sequence="90"
    />
</odoo>
