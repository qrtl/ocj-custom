<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.ship.to</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <page name="extra" position="before">
                <page
                    name="integration"
                    string="Integration"
                    invisible="picking_type_code == 'internal'"
                >
                    <group>
                        <group
                            name="ship_to"
                            string="Ship To"
                            invisible="picking_type_code != 'outgoing'"
                        >
                            <field
                                name="ship_to_name"
                                readonly="state in ('done', 'cancel')"
                            />
                            <field
                                name="ship_to_address"
                                readonly="state in ('done', 'cancel')"
                            />
                            <field
                                name="ship_to_phone"
                                readonly="state in ('done', 'cancel')"
                            />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
