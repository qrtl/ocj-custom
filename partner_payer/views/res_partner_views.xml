<odoo>
    <record id="view_partner_property_form_inherit_payer" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.payer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field
                    name="payer_partner_id"
                    domain="[('id', '!=', id)]"
                    context="{'default_is_company': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
