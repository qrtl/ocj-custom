<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.prorated.product</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_billing_policy.view_partner_form" />
        <field name="arch" type="xml">
            <field name="prorated_billing" position="after">
                <field
                    name="prorated_product_tmpl_ids"
                    widget="many2many_tags"
                    invisible="not prorated_billing"
                    readonly="parent_id"
                />
            </field>
        </field>
    </record>
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.select.prorated.product</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <!-- Which customers are prorated on a given piece of equipment. -->
            <field name="user_id" position="after">
                <field name="prorated_product_tmpl_ids" />
            </field>
        </field>
    </record>
</odoo>
