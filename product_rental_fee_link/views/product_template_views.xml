<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.rental.fee.link</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_classification.product_template_view_form"
        />
        <field name="arch" type="xml">
            <field name="product_kind" position="after">
                <field
                    name="rental_fee_product_tmpl_ids"
                    invisible="product_kind not in ('equipment', 'accessory')"
                    options="{'no_quick_create': True}"
                >
                    <list>
                        <field name="name" />
                    </list>
                </field>
                <!-- The mirror of the set, read-only: a set is maintained from
                     the rental fee product, which is where it is one list
                     rather than one row per member. -->
                <field
                    name="rental_set_fee_tmpl_ids"
                    invisible="product_kind not in ('equipment', 'accessory')"
                >
                    <list>
                        <field name="name" />
                    </list>
                </field>
            </field>
            <!-- A page of its own: the set is a list of products, which does
                 not fit the Classification group, and it is the one thing a
                 rental fee product is configured for. -->
            <xpath expr="//page[@name='general_information']" position="after">
                <page
                    name="rental_set"
                    string="Rental Set"
                    invisible="type != 'service'"
                >
                    <field
                        name="rental_set_component_ids"
                        options="{'no_quick_create': True}"
                    >
                        <list>
                            <field name="default_code" />
                            <field name="display_name" />
                            <field name="product_kind" />
                            <field name="equipment_classification_id" />
                        </list>
                    </field>
                    <group>
                        <field name="rental_set_key" groups="base.group_no_one" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.search.rental.fee.link</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <field name="product_tag_ids" position="after">
                <field name="rental_fee_product_tmpl_ids" />
                <field name="equipment_tmpl_ids" />
                <field name="rental_set_component_ids" />
                <separator />
                <filter
                    string="Rental Fee Product Missing"
                    name="rental_fee_product_missing"
                    domain="[('rental_fee_product_tmpl_ids', '=', False), ('product_kind', 'in', ('equipment', 'accessory'))]"
                />
                <filter
                    string="Rental Set"
                    name="rental_set"
                    domain="[('rental_set_key', '!=', False)]"
                />
            </field>
        </field>
    </record>
</odoo>
