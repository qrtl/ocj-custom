<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.time.slot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field
                    name="delivery_time_slot_id"
                    invisible="picking_type_code != 'outgoing'"
                    readonly="state in ('done', 'cancel')"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>

    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.list.delivery.time.slot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="delivery_time_slot_id" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
