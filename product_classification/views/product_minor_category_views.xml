<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_minor_category_view_list" model="ir.ui.view">
        <field name="name">product.minor.category.list</field>
        <field name="model">product.minor.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <record id="product_minor_category_action" model="ir.actions.act_window">
        <field name="name">Minor Categories</field>
        <field name="res_model">product.minor.category</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="product_minor_category_menu"
        action="product_minor_category_action"
        parent="stock.menu_product_in_config_stock"
        sequence="105"
    />
</odoo>
