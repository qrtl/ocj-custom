<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree" model="ir.ui.view">
        <field name="name">stock.quant.list.quality.status</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="quality_status_id" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.quality.status</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="quality_status_id" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="quant_search_view" model="ir.ui.view">
        <field name="name">stock.quant.search.quality.status</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="quality_status_id" />
            </xpath>
            <xpath expr="//filter[@name='Lot_Serial_number']" position="after">
                <filter
                    string="Quality Status"
                    name="quality_status_group"
                    domain="[]"
                    context="{'group_by': 'quality_status_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
