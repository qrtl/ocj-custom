<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.billing.policy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="billing_policy" string="Billing Policy">
                    <group>
                        <group>
                            <field name="billing_scope" />
                            <field name="revenue_timing" />
                        </group>
                        <group>
                            <field name="prorated_billing" />
                            <field name="bill_on_loss" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
