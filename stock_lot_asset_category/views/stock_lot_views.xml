<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="name">stock.lot.form.asset.category</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="asset_category_locked" invisible="1" />
                <field
                    name="asset_category_id"
                    options="{'no_quick_create': True}"
                    readonly="asset_category_locked"
                />
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_tree" model="ir.ui.view">
        <field name="name">stock.lot.list.asset.category</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="asset_category_locked" column_invisible="1" />
                <field
                    name="asset_category_id"
                    optional="show"
                    readonly="asset_category_locked"
                />
            </xpath>
        </field>
    </record>

    <record id="search_product_lot_filter" model="ir.ui.view">
        <field name="name">stock.lot.search.asset.category</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="asset_category_id" />
            </xpath>
            <xpath expr="//filter[@name='group_by_product']" position="before">
                <filter
                    name="group_by_asset_category"
                    string="Asset Category"
                    domain="[]"
                    context="{'group_by': 'asset_category_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
