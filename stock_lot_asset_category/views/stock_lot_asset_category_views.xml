<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_lot_asset_category_view_list" model="ir.ui.view">
        <field name="name">stock.lot.asset.category.list</field>
        <field name="model">stock.lot.asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <record id="stock_lot_asset_category_view_search" model="ir.ui.view">
        <field name="name">stock.lot.asset.category.search</field>
        <field name="model">stock.lot.asset.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="stock_lot_asset_category_action" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">stock.lot.asset.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an asset category
            </p>
            <p>
                Asset categories record who owns each serial/lot number.
            </p>
        </field>
    </record>

    <menuitem
        id="stock_lot_asset_category_menu"
        action="stock_lot_asset_category_action"
        parent="stock.menu_stock_config_settings"
        sequence="101"
        groups="stock.group_stock_manager"
    />
</odoo>
