<odoo>
    <record id="hr_employee_view_form_inherit_employee_code" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.code</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="before">
                <group name="employee_code_group" string="Employee Code">
                    <field name="employee_code" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
